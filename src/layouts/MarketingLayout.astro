---
import BaseLayout from "./BaseLayout.astro";
import SEO, { type SEOArticle } from "../components/seo/SEO.astro";
import { type Locale } from "../lib/site-config";

export interface Props {
  title: string;
  description: string;
  locale: Locale;
  path: string;
  canonical?: string;
  robots?: string;
  article?: SEOArticle;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title,
  description,
  locale,
  path,
  canonical,
  robots,
  article,
  jsonLd,
} = Astro.props as Props;
---

<BaseLayout
  title={title}
  description={description}
  locale={locale}
  path={path}
  showThemeToggle={true}
>
  <SEO
    slot="seo"
    title={title}
    description={description}
    locale={locale}
    path={path}
    canonical={canonical}
    robots={robots}
    article={article}
    jsonLd={jsonLd}
    ogImage={path === "/" ? `/og/home/${locale}` : `/og/page/${locale}${path}`}
  />
  <slot />
</BaseLayout>
