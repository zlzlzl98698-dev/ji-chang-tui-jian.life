---
import type { AirportRecord } from "../../data/airports";

export interface Props {
  airport: AirportRecord;
}

const { airport } = Astro.props;
---

<div class={`airport-card ${airport.isFeatured ? "airport-card--featured" : ""}`} data-airport-card data-name={airport.name} data-line={airport.lineType} data-protocol={airport.protocols.join(",")}>
  <div class="airport-card__header">
    <div class="airport-card__title-row">
      <div class="airport-card__rank-badge" class:list={{ "is-gold": airport.rank === 1, "is-top3": airport.rank <= 3 && airport.rank > 1 }}>
        TOP {airport.rank}
      </div>
      <h3 class="airport-card__name">
        <a href={`/airports/${airport.slug}`}>{airport.name}</a>
      </h3>
      {airport.isFeatured && <span class="airport-card__tag-featured">首推推荐</span>}
    </div>
    <div class="airport-card__price-badge">
      <span class="airport-card__price-val">{airport.minPrice}</span>
    </div>
  </div>

  <div class="airport-card__meta">
    <div class="airport-card__line-type">
      <span class="status-indicator"></span>
      <span class="line-label">{airport.lineType}</span>
    </div>
    <div class="airport-card__protocols">
      {airport.protocols.map((p) => (
        <span class="protocol-tag">{p}</span>
      ))}
    </div>
  </div>

  <p class="airport-card__desc">
    {airport.highlights[0] || airport.description.slice(0, 70) + "..."}
  </p>

  <div class="airport-card__unlock">
    <div class="unlock-item">
      <span class="unlock-label">AI 支持:</span>
      <span class="unlock-val">{airport.unlockInfo.ai.slice(0, 2).join(" · ")}</span>
    </div>
    <div class="unlock-item">
      <span class="unlock-label">流媒体:</span>
      <span class="unlock-val">{airport.unlockInfo.streaming.slice(0, 3).join(" · ")}</span>
    </div>
  </div>

  {airport.coupon && (
    <div class="airport-card__coupon">
      <span class="coupon-label">优惠码:</span>
      <code class="coupon-code">{airport.coupon}</code>
    </div>
  )}

  <div class="airport-card__footer">
    <a href={`/airports/${airport.slug}`} class="btn-detail">
      评测报告
    </a>
    <a
      href={airport.affLink}
      target="_blank"
      rel="nofollow sponsored noopener"
      class="btn-visit"
    >
      直达官网
      <span class="arrow" aria-hidden="true">→</span>
    </a>
  </div>
</div>

<style>
  .airport-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: var(--space-lg);
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.2s ease, box-shadow 0.2s ease;
    position: relative;
  }

  .airport-card:hover {
    transform: translateY(-2px);
    border-color: var(--ring);
    box-shadow: 0 12px 24px -10px color-mix(in srgb, var(--foreground) 10%, transparent);
  }

  .airport-card--featured {
    border: 2px solid var(--primary);
    background: color-mix(in srgb, var(--primary) 3%, var(--card));
  }

  .airport-card__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
  }

  .airport-card__title-row {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    flex-wrap: wrap;
  }

  .airport-card__rank-badge {
    font-size: var(--text-code-sm);
    font-weight: 800;
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-sm);
    background: var(--secondary);
    color: var(--secondary-foreground);
    letter-spacing: 0.05em;
  }

  .airport-card__rank-badge.is-gold {
    background: var(--primary);
    color: var(--primary-foreground);
  }

  .airport-card__name {
    font-size: 1.15rem;
    font-weight: 700;
    margin: 0;
  }

  .airport-card__name a {
    color: var(--foreground);
    text-decoration: none;
  }

  .airport-card__name a:hover {
    text-decoration: underline;
  }

  .airport-card__tag-featured {
    font-size: 0.7rem;
    background: color-mix(in srgb, var(--primary) 15%, transparent);
    color: var(--primary);
    padding: 0.15rem 0.4rem;
    border-radius: var(--radius-full);
    font-weight: 700;
  }

  .airport-card__price-badge {
    text-align: right;
  }

  .airport-card__price-val {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--primary);
  }

  .airport-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
    margin-bottom: var(--space-sm);
  }

  .airport-card__line-type {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--muted-foreground);
  }

  .status-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--success);
    display: inline-block;
  }

  .airport-card__protocols {
    display: inline-flex;
    gap: 0.25rem;
  }

  .protocol-tag {
    font-size: 0.7rem;
    font-family: var(--font-mono);
    padding: 0.1rem 0.35rem;
    border-radius: var(--radius-sm);
    background: var(--muted);
    color: var(--foreground);
  }

  .airport-card__desc {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--muted-foreground);
    margin: 0 0 var(--space-md) 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .airport-card__unlock {
    background: var(--secondary);
    border-radius: var(--radius-md);
    padding: var(--space-xs) var(--space-sm);
    font-size: 0.775rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    margin-bottom: var(--space-md);
  }

  .unlock-item {
    display: flex;
    gap: 0.4rem;
  }

  .unlock-label {
    color: var(--muted-foreground);
    font-weight: 600;
    min-width: 3.5rem;
  }

  .unlock-val {
    color: var(--foreground);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .airport-card__coupon {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.775rem;
    margin-bottom: var(--space-md);
  }

  .coupon-label {
    color: var(--muted-foreground);
  }

  .coupon-code {
    background: var(--muted);
    border: 1px dashed var(--border);
    padding: 0.1rem 0.4rem;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--foreground);
  }

  .airport-card__footer {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: var(--space-xs);
    margin-top: auto;
  }

  .btn-detail {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.45rem 0.8rem;
    border-radius: var(--radius-md);
    font-size: 0.825rem;
    font-weight: 600;
    text-decoration: none;
    background: var(--secondary);
    color: var(--secondary-foreground);
    border: 1px solid var(--border);
    transition: background 0.15s ease;
  }

  .btn-detail:hover {
    background: var(--secondary-hover);
  }

  .btn-visit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    padding: 0.45rem 0.8rem;
    border-radius: var(--radius-md);
    font-size: 0.825rem;
    font-weight: 700;
    text-decoration: none;
    background: var(--primary);
    color: var(--primary-foreground);
    transition: opacity 0.15s ease;
  }

  .btn-visit:hover {
    opacity: 0.92;
  }

  .btn-visit .arrow {
    transition: transform 0.15s ease;
  }

  .btn-visit:hover .arrow {
    transform: translateX(2px);
  }
</style>
