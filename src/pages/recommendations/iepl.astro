---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import { getAirportsByCategory } from "../../data/topics/recommendationsData";
import { airports } from "../../data/airports";

const locale = (Astro.currentLocale || "en") as "en";
const catAirports = getAirportsByCategory("iepl");
const guangsu = airports.find((a) => a.slug === "guangsu") || airports[0];
---

<MarketingLayout
  title="IEPL/IPLC 跨境企业物理专线机场推荐 (2026最新横评) | 机场life"
  description="2026年企业级IEPL/IPLC物理内网专线深度评测与选型推荐。全程不过GFW公网审查，晚高峰丢包稳定低于0.1%，4K秒开，支持跨境办公与严肃生产力。"
  locale={locale}
  path="/recommendations/iepl"
>
  <article class="container py-12 max-w-5xl mx-auto">
    <nav class="breadcrumb mb-6" aria-label="Breadcrumb">
      <ol class="flex items-center gap-2 text-sm text-muted-foreground">
        <li><a href="/" class="hover:text-primary transition-colors">首页</a></li>
        <li><span>/</span></li>
        <li><a href="/recommendations" class="hover:text-primary transition-colors">选购指南</a></li>
        <li><span>/</span></li>
        <li class="text-foreground font-medium" aria-current="page">IEPL企业专线专题</li>
      </ol>
    </nav>

    <header class="page-head max-w-4xl mb-12">
      <div class="inline-badge mb-3">企业级专线专题 · 核心选购指南</div>
      <h1 class="page-title mb-4">IEPL/IPLC 跨境企业物理专线深度横评推荐</h1>
      <p class="page-lead">
        对于跨境办公、学术科研与金融外汇操盘手而言，网络断流与高丢包是致命风险。本专栏只收录通过机房物理级 IEPL/IPLC 真实验证的顶级专线品牌，保障极端敏感时期稳如泰山。
      </p>
    </header>

    <!-- Top Pick Box -->
    <div class="p-6 rounded-2xl border border-primary/40 bg-card mb-12">
      <div class="flex items-center gap-2 text-xs font-bold text-primary mb-2">
        <span>🏆 本专题年度综合第一名推荐</span>
      </div>
      <h2 class="text-2xl font-bold text-foreground mb-2">光速云 (Guangsu Cloud) —— 深圳-香港企业 IEPL 物理专线</h2>
      <p class="text-sm text-muted-foreground mb-4 leading-relaxed">
        独家配置深港两端物理裸纤以太网直连，晚高峰丢包率控制在 0.05% 以内。轻量版年付仅需 99 元（折合 8.25 元/月），彻底击穿了企业专线昂贵的定价壁垒。
      </p>
      <div class="flex flex-wrap gap-3">
        <a
          href={guangsu.affLink}
          target="_blank"
          rel="nofollow sponsored noopener"
          class="cta-btn cta-primary"
        >
          直达光速云官网 (优惠码 AMM)
        </a>
        <a href="/airports/guangsu" class="cta-btn cta-secondary">
          查看光速云测速报告
        </a>
      </div>
    </div>

    <!-- Recommended List -->
    <section class="mb-14">
      <h2 class="text-xl font-bold mb-6 flex items-center gap-2">
        <span class="indicator-dot"></span> 经 NOC 实验室核验的 IEPL 专线精选阵容
      </h2>
      <div class="space-y-6">
        {catAirports.map((airport, idx) => (
          <div class="p-6 rounded-xl border border-border bg-card flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
            <div class="space-y-2">
              <div class="flex items-center gap-3">
                <span class="text-sm font-bold text-muted-foreground">0{idx + 1}</span>
                <h3 class="text-lg font-bold text-foreground">
                  <a href={`/airports/${airport.slug}`} class="hover:text-primary transition-colors">
                    {airport.name}
                  </a>
                </h3>
                <span class="px-2 py-0.5 rounded text-xs bg-muted text-muted-foreground font-medium">
                  {airport.lineType}
                </span>
              </div>
              <p class="text-xs text-muted-foreground max-w-xl">{airport.description}</p>
              <div class="flex flex-wrap gap-2 text-xs text-muted-foreground">
                <span>起步价：<strong class="text-primary">{airport.minPrice}</strong></span>
                <span>·</span>
                <span>协议：{airport.protocols.join(", ")}</span>
                <span>·</span>
                <span>建站时间：{airport.establishedYear}</span>
              </div>
            </div>
            <div class="flex items-center gap-3 w-full md:w-auto shrink-0">
              <a
                href={airport.affLink}
                target="_blank"
                rel="nofollow sponsored noopener"
                class="cta-btn cta-primary text-xs"
              >
                访问官网
              </a>
              <a href={`/airports/${airport.slug}`} class="cta-btn cta-secondary text-xs">
                详细评测
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Deep Analysis -->
    <section class="prose-section mb-14">
      <h2 class="section-title">IEPL 专线选型必备知识：为什么说公网中转无法比拟？</h2>
      <div class="space-y-4 text-sm text-muted-foreground leading-relaxed">
        <p>
          在跨国网络通信中，公网直连（哪怕是三网直连的 CN2 GIA）依然会受到国际出口公网路由拥堵的影响。一旦进入每晚 20:00 - 24:00 的晚高峰，由于中国电信、联通、移动的骨干网互联带宽饱和，运营商会对普通用户的 UDP 和 TCP 数据包实施 QoS 丢包处理。
        </p>
        <p>
          IEPL 专线则完全不同。服务商在深圳、上海等骨干机房部署汇聚接入点，两端机房之间直接租用物理光缆或波分复用电路（二层以太网透明传输），数据在端内传输，物理隔离，既不受公网国际拥堵影响，也完全规避了 GFW 的审查探针与封锁规则。
        </p>
      </div>
    </section>

    <!-- Navigation Hub Footer -->
    <div class="p-6 rounded-xl border border-border bg-muted/30 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div>
        <h4 class="font-bold text-sm text-foreground">探索其他细分场景选购指南</h4>
        <p class="text-xs text-muted-foreground">涵盖平价月付、流媒体解锁与按量计费全景推荐</p>
      </div>
      <div class="flex flex-wrap gap-2">
        <a href="/recommendations/budget" class="cta-btn cta-secondary text-xs">平价性价比</a>
        <a href="/recommendations/streaming" class="cta-btn cta-secondary text-xs">流媒体解锁</a>
        <a href="/recommendations/non-expiring" class="cta-btn cta-secondary text-xs">按量不限时</a>
      </div>
    </div>
  </article>
</MarketingLayout>

<style>
  .inline-badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: 9999px;
    background: var(--muted);
    color: var(--primary);
  }
  .page-title {
    font-size: 2.25rem;
    font-weight: 900;
    line-height: 1.2;
    color: var(--foreground);
  }
  .page-lead {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--muted-foreground);
  }
  .indicator-dot {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 9999px;
    background: var(--primary);
    display: inline-block;
  }
  .cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 1rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .cta-primary {
    background: var(--primary);
    color: var(--primary-foreground);
  }
  .cta-secondary {
    background: var(--secondary);
    color: var(--secondary-foreground);
    border: 1px solid var(--border);
  }
  .section-title {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--foreground);
    margin-bottom: 1rem;
  }
</style>
