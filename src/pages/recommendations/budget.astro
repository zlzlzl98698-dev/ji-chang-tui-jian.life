---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import { getAirportsByCategory } from "../../data/topics/recommendationsData";
import { airports } from "../../data/airports";

const locale = (Astro.currentLocale || "en") as "en";
const catAirports = getAirportsByCategory("budget");
const guangsu = airports.find((a) => a.slug === "guangsu") || airports[0];
---

<MarketingLayout
  title="平价高性价比与学生党月付机场推荐 (2026最新选型) | 机场life"
  description="2026年精选平价翻墙机场梯子推荐：月均10元以内的学生党与轻量出海高性价比服务商横评。拒绝套路跑路站，精选灵活月付、不限设备、真材实料的优质品牌。"
  locale={locale}
  path="/recommendations/budget"
>
  <article class="container py-12 max-w-5xl mx-auto">
    <nav class="breadcrumb mb-6" aria-label="Breadcrumb">
      <ol class="flex items-center gap-2 text-sm text-muted-foreground">
        <li><a href="/" class="hover:text-primary transition-colors">首页</a></li>
        <li><span>/</span></li>
        <li><a href="/recommendations" class="hover:text-primary transition-colors">选购指南</a></li>
        <li><span>/</span></li>
        <li class="text-foreground font-medium" aria-current="page">平价高性价比专题</li>
      </ol>
    </nav>

    <header class="page-head max-w-4xl mb-12">
      <div class="inline-badge mb-3">高性价比专题 · 学生与轻量之选</div>
      <h1 class="page-title mb-4">平价高性价比与学生党月付机场选型指南</h1>
      <p class="page-lead">
        谁说好机场一定动辄几十元？本专题严选月均开销在 10 元左右的亲民标杆。我们严格排除了只靠疯狂超售骗钱的跑路站，为您筛选真实稳定、流量足额、支持月付的超值之选。
      </p>
    </header>

    <!-- Top Pick Box -->
    <div class="p-6 rounded-2xl border border-primary/40 bg-card mb-12">
      <div class="flex items-center gap-2 text-xs font-bold text-primary mb-2">
        <span>🏆 平价专题越级推荐 · 8元享企业专线</span>
      </div>
      <h2 class="text-2xl font-bold text-foreground mb-2">光速云 (Guangsu Cloud) —— 99元/年 轻量专线版</h2>
      <p class="text-sm text-muted-foreground mb-4 leading-relaxed">
        折合每月仅需 8.25 元！在同价位其他机场只能提供严重拥堵的公网直连或免费 CF 反代时，光速云直接以月均 8 元提供企业级 IEPL 内网专线，晚高峰 4K 随意看，性价比无可争议。
      </p>
      <div class="flex flex-wrap gap-3">
        <a
          href={guangsu.affLink}
          target="_blank"
          rel="nofollow sponsored noopener"
          class="cta-btn cta-primary"
        >
          直达光速云官网 (优惠码 AMM)
        </a>
        <a href="/airports/guangsu" class="cta-btn cta-secondary">
          查看光速云深度报告
        </a>
      </div>
    </div>

    <!-- Recommended List -->
    <section class="mb-14">
      <h2 class="text-xl font-bold mb-6 flex items-center gap-2">
        <span class="indicator-dot"></span> 经过严苛筛选的高性价比精选阵容
      </h2>
      <div class="space-y-6">
        {catAirports.map((airport, idx) => (
          <div class="p-6 rounded-xl border border-border bg-card flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
            <div class="space-y-2">
              <div class="flex items-center gap-3">
                <span class="text-sm font-bold text-muted-foreground">0{idx + 1}</span>
                <h3 class="text-lg font-bold text-foreground">
                  <a href={`/airports/${airport.slug}`} class="hover:text-primary transition-colors">
                    {airport.name}
                  </a>
                </h3>
                <span class="px-2 py-0.5 rounded text-xs bg-muted text-muted-foreground font-medium">
                  {airport.lineType}
                </span>
              </div>
              <p class="text-xs text-muted-foreground max-w-xl">{airport.description}</p>
              <div class="flex flex-wrap gap-2 text-xs text-muted-foreground">
                <span>起步价：<strong class="text-primary">{airport.minPrice}</strong></span>
                <span>·</span>
                <span>协议：{airport.protocols.join(", ")}</span>
                <span>·</span>
                <span>建站时间：{airport.establishedYear}</span>
              </div>
            </div>
            <div class="flex items-center gap-3 w-full md:w-auto shrink-0">
              <a
                href={airport.affLink}
                target="_blank"
                rel="nofollow sponsored noopener"
                class="cta-btn cta-primary text-xs"
              >
                访问官网
              </a>
              <a href={`/airports/${airport.slug}`} class="cta-btn cta-secondary text-xs">
                详细评测
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Deep Analysis -->
    <section class="prose-section mb-14">
      <h2 class="section-title">学生党与预算有限用户的 3 大避坑铁律</h2>
      <div class="space-y-4 text-sm text-muted-foreground leading-relaxed">
        <p>
          <strong>铁律一：坚决不要一次性买两年。</strong> 很多不知名的小机场打着『学生优惠』的幌子，卖 69 元三年。这种机场在回笼几万块资金后往往就会失联。建议新手先买月付，测试体验好再考虑年付。
        </p>
        <p>
          <strong>铁律二：注意流量重置日与扣费周期。</strong> 多数机场是按自然月或账单日重置流量。如果当月流量用不完，建议选择支持『流量按量计费不过期』的备用套餐。
        </p>
        <p>
          <strong>铁律三：警惕隐形倍率偷跑流量。</strong> 检查节点名称后缀，避开 3.0x、5.0x 的高倍率节点，多使用 1.0x 或 0.5x 节点，让有限的流量发挥最大价值。
        </p>
      </div>
    </section>

    <!-- Navigation Hub Footer -->
    <div class="p-6 rounded-xl border border-border bg-muted/30 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div>
        <h4 class="font-bold text-sm text-foreground">探索其他细分场景选购指南</h4>
        <p class="text-xs text-muted-foreground">涵盖IEPL企业专线、流媒体解锁与按量计费全景推荐</p>
      </div>
      <div class="flex flex-wrap gap-2">
        <a href="/recommendations/iepl" class="cta-btn cta-secondary text-xs">IEPL企业专线</a>
        <a href="/recommendations/streaming" class="cta-btn cta-secondary text-xs">流媒体解锁</a>
        <a href="/recommendations/non-expiring" class="cta-btn cta-secondary text-xs">按量不限时</a>
      </div>
    </div>
  </article>
</MarketingLayout>

<style>
  .inline-badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: 9999px;
    background: var(--muted);
    color: var(--primary);
  }
  .page-title {
    font-size: 2.25rem;
    font-weight: 900;
    line-height: 1.2;
    color: var(--foreground);
  }
  .page-lead {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--muted-foreground);
  }
  .indicator-dot {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 9999px;
    background: var(--primary);
    display: inline-block;
  }
  .cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 1rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .cta-primary {
    background: var(--primary);
    color: var(--primary-foreground);
  }
  .cta-secondary {
    background: var(--secondary);
    color: var(--secondary-foreground);
    border: 1px solid var(--border);
  }
  .section-title {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--foreground);
    margin-bottom: 1rem;
  }
</style>
