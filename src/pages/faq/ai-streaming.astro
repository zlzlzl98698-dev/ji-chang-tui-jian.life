---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import { comprehensiveFaqs } from "../../data/topics/faqData";
import { airports } from "../../data/airports";

const locale = (Astro.currentLocale || "en") as "en";
const faqs = comprehensiveFaqs.filter((f) => f.category === "ai-streaming");
const guangsu = airports.find((a) => a.slug === "guangsu") || airports[0];
---

<MarketingLayout
  title="ChatGPT / Claude 封禁与 Netflix 解锁 FAQ (2026最新) | 机场life"
  description="深度解答ChatGPT Access Denied 1020报错解决、Claude 3.5 Sonnet防封指南、Netflix非自制剧解锁、Disney+与流媒体住宅IP清洗技巧。"
  locale={locale}
  path="/faq/ai-streaming"
>
  <article class="container py-12 max-w-5xl mx-auto">
    <nav class="breadcrumb mb-6" aria-label="Breadcrumb">
      <ol class="flex items-center gap-2 text-sm text-muted-foreground">
        <li><a href="/" class="hover:text-primary transition-colors">首页</a></li>
        <li><span>/</span></li>
        <li><a href="/faq" class="hover:text-primary transition-colors">机场FAQ</a></li>
        <li><span>/</span></li>
        <li class="text-foreground font-medium" aria-current="page">AI与流媒体解锁</li>
      </ol>
    </nav>

    <header class="page-head max-w-4xl mb-12">
      <div class="inline-badge mb-3">FAQ 细分专题 · AI 与流媒体</div>
      <h1 class="page-title mb-4">大语言模型与国际流媒体解锁排障</h1>
      <p class="page-lead">
        为什么访问 ChatGPT 频繁弹出 Access Denied？为什么 Netflix 搜不到热门版权剧目？本专栏带你了解风控 IP 数据库检测机制，彻底搞定解锁难题。
      </p>
    </header>

    <div class="space-y-6 mb-16">
      {faqs.map((item) => (
        <div class="p-6 rounded-xl border border-border bg-card space-y-4">
          <h2 class="text-lg font-bold text-foreground">❓ {item.question}</h2>
          <div class="p-3 rounded-lg bg-muted text-xs text-foreground font-medium">
            <strong>核心简答：</strong> {item.shortAnswer}
          </div>
          <p class="text-sm text-muted-foreground leading-relaxed">{item.fullAnswer}</p>
          {item.actionSteps && (
            <div class="p-4 rounded-lg border border-border bg-card/60 text-xs text-muted-foreground space-y-1">
              <strong class="text-foreground block mb-1">🛠️ 排障 SOP：</strong>
              <ul class="list-disc list-inside space-y-1">
                {item.actionSteps.map((s) => (<li>{s}</li>))}
              </ul>
            </div>
          )}
        </div>
      ))}
    </div>

    <!-- Spotlight -->
    <div class="p-6 rounded-2xl border border-primary/40 bg-card flex flex-col md:flex-row items-center justify-between gap-6">
      <div>
        <h3 class="font-bold text-foreground mb-1">原生双 ISP 住宅出口：光速云全量解锁标杆</h3>
        <p class="text-xs text-muted-foreground">ChatGPT 4o、Claude 3.5 Sonnet、Netflix 4K HDR 全面支持，零弹验证码，99元/年超高性价比。</p>
      </div>
      <a
        href={guangsu.affLink}
        target="_blank"
        rel="nofollow sponsored noopener"
        class="cta-btn cta-primary whitespace-nowrap"
      >
        直达光速云 (享专属优惠)
      </a>
    </div>
  </article>
</MarketingLayout>

<style>
  .inline-badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: 9999px;
    background: var(--muted);
    color: var(--primary);
  }
  .page-title {
    font-size: 2.25rem;
    font-weight: 900;
    line-height: 1.2;
    color: var(--foreground);
  }
  .page-lead {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--muted-foreground);
  }
  .cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 1rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .cta-primary {
    background: var(--primary);
    color: var(--primary-foreground);
  }
</style>
