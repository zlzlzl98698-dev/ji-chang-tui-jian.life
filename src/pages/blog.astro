---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { t } from "../i18n/ui";
import { resolveRoute } from "../i18n/routes";
import { siteConfig } from "../config/site.config";
import { BlogCard } from "../components/blog/index";
import Pagination from "../components/ui/data-display/Pagination/Pagination.astro";

const locale = (Astro.currentLocale || "en") as "en";
const searchParams = Astro.url.searchParams;
const currentTag = searchParams.get("tag") ?? "";
const currentPage = Math.max(1, Number(searchParams.get("page") || "1"));
const slugify = (value: string) =>
  value
    .trim()
    .toLowerCase()
    .replace(/['"]/g, "")
    .replace(/[^a-z0-9\u4e00-\u9fa5]+/g, "-")
    .replace(/^-+|-+$/g, "");

const allPosts: CollectionEntry<"blog">[] = await getCollection("blog");
const posts = allPosts
  .filter((p) => p.data.locale === locale && !p.data.draft)
  .sort(
    (a, b) =>
      new Date(b.data.publishDate).getTime() -
      new Date(a.data.publishDate).getTime(),
  );

const filteredPosts = currentTag
  ? posts.filter((post) =>
      (post.data.tags ?? []).some((tag: string) => slugify(tag) === currentTag),
    )
  : posts;
const featuredPost =
  currentPage === 1
    ? (filteredPosts.find((post) => post.data.featured) ?? filteredPosts[0])
    : undefined;
const gridPosts = featuredPost
  ? filteredPosts.filter((post) => post.id !== featuredPost.id)
  : filteredPosts;
const postsPerPage = siteConfig.blog.postsPerPage;
const totalPages = Math.max(1, Math.ceil(gridPosts.length / postsPerPage));
const pagePosts = gridPosts.slice(
  (currentPage - 1) * postsPerPage,
  currentPage * postsPerPage,
);
const allTags = [
  ...new Set(posts.flatMap((post) => post.data.tags || [])),
].sort((a, b) => a.localeCompare(b));
---

<BaseLayout
  title="网络加速与专线技术专栏 - 节点测速、协议解析与避坑指南 | 机场life"
  description="机场life技术专栏：深度解析IEPL/IPLC跨境专线架构、VLESS/Hysteria2协议原理、ChatGPT与海外流媒体解锁防风控方案，以及科学上网客户端实战配置教程。"
  locale={locale}
  path={resolveRoute(locale, "/blog")}
>
  <main class="blog-list container py-12">
    <header class="blog-list__hero">
      <h1>网络加速与专线技术专栏</h1>
      <p class="blog-list__lead">
        深耕跨境网络专线架构、主流代理协议深度评测、ChatGPT与海外流媒体解锁指南及客户端实战配置。
      </p>
      <p class="blog-list__count">
        共发布 <strong>{filteredPosts.length}</strong> 篇实测与深度解析文章
        {currentTag && <> · 当前分类 <strong>#{currentTag}</strong></>}
      </p>
    </header>

    {
      allTags.length > 0 && (
        <nav class="blog-list__tags" aria-label={t(locale, "blog.filterByTag")}>
          <a
            href={resolveRoute(locale, "/blog")}
            class={`blog-chip${currentTag ? "" : " blog-chip--active"}`}
          >
            全部
          </a>
          {allTags.map((tag) => {
            const tagSlug = slugify(tag);
            const active = currentTag === tagSlug;
            const href = active
              ? resolveRoute(locale, "/blog")
              : `${resolveRoute(locale, "/blog")}?tag=${encodeURIComponent(tagSlug)}`;
            return (
              <a
                href={href}
                class={`blog-chip${active ? " blog-chip--active" : ""}`}
              >
                {tag}
              </a>
            );
          })}
        </nav>
      )
    }

    {
      filteredPosts.length === 0 && (
        <div class="blog-list__empty">
          <p class="blog-list__empty-title">{t(locale, "blog.noResults")}</p>
          <a class="blog-list__empty-cta" href={resolveRoute(locale, "/blog")}>
            {t(locale, "blog.allPosts")}
          </a>
        </div>
      )
    }

    {
      featuredPost && currentPage === 1 && (
        <section class="blog-list__featured" aria-label="Featured article">
          <BlogCard
            post={featuredPost}
            variant="list"
            locale={locale}
            headingLevel="h2"
          />
        </section>
      )
    }

    {
      pagePosts.length > 0 && (
        <section class="blog-list__grid">
          {pagePosts.map((post) => (
            <BlogCard
              post={post}
              variant="grid"
              locale={locale}
              headingLevel="h2"
            />
          ))}
        </section>
      )
    }

    {
      totalPages > 1 && (
        <Pagination
          currentPage={currentPage}
          totalPages={totalPages}
          basePath={resolveRoute(locale, "/blog")}
          query={currentTag ? { tag: currentTag } : undefined}
          locale={locale}
        />
      )
    }
  </main>
</BaseLayout>

<style>
  .blog-list__hero {
    margin-bottom: var(--space-2xl);
  }

  .blog-list__lead {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    margin-top: var(--space-xs);
    margin-bottom: var(--space-xs);
  }

  .blog-list__count {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .blog-list__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-bottom: var(--space-2xl);
  }

  .blog-chip {
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--color-text-secondary);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    transition: all 0.15s ease;
  }

  .blog-chip:hover {
    color: var(--color-text-primary);
    border-color: var(--color-text-secondary);
  }

  .blog-chip--active {
    color: var(--color-bg-primary);
    background: var(--color-text-primary);
    border-color: var(--color-text-primary);
  }

  .blog-list__featured {
    margin-bottom: var(--space-2xl);
  }

  .blog-list__grid {
    display: grid;
    gap: var(--space-xl);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
  }

  .blog-list__empty {
    text-align: center;
    padding: var(--space-3xl) 0;
  }

  .blog-list__empty-title {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-md);
  }

  .blog-list__empty-cta {
    display: inline-block;
    padding: var(--space-xs) var(--space-md);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text-primary);
    text-decoration: none;
    font-weight: 500;
  }
</style>
